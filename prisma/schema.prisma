// Prisma Schema — Barbershop Management
// Documentación: https://pris.ly/d/prisma-schema

// Prisma v7: motor WASM, conexión via @prisma/adapter-pg (ver src/lib/db.ts)
// La URL se provee en el constructor de PrismaClient, no aquí
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// SHOP — Multi-tenant root
// ─────────────────────────────────────────
model Shop {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  address   String?
  phone     String?
  email     String?
  taxId     String?      // NEQ / TPS / TVQ
  currency  String   @default("CAD")
  createdAt DateTime @default(now())

  users        User[]
  clients      Client[]
  invoices     Invoice[]
  reminders    ServiceReminder[]
  documents    AccountingDocument[]
  services     Service[]
  appointments Appointment[]
}

// ─────────────────────────────────────────
// USER — Barbershop staff
// ─────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id])
  name         String
  email        String   @unique
  passwordHash String?
  role         Role     @default(BARBER)
  createdAt    DateTime @default(now())

  // NextAuth required
  accounts     Account[]
  sessions     Session[]
  appointments Appointment[]
}

enum Role {
  OWNER
  BARBER
  VIEWER
}

// ─────────────────────────────────────────
// NEXTAUTH — Required tables
// ─────────────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────
// CLIENT
// ─────────────────────────────────────────
model Client {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  firstName String
  lastName  String
  email     String?
  phone     String?
  address   String?
  notes     String?  @db.Text
  hairNotes String?  @db.Text  // preferred style, usual length, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments  Appointment[]
  invoices      Invoice[]
  reminders     ServiceReminder[]
}

// ─────────────────────────────────────────
// SERVICE — Catalog of barbershop services
// ─────────────────────────────────────────
model Service {
  id              String   @id @default(cuid())
  shopId          String
  shop            Shop     @relation(fields: [shopId], references: [id])
  name            String   // "Corte clásico", "Fade", "Barba", etc.
  description     String?
  durationMinutes Int      @default(30)
  price           Decimal  @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  appointments Appointment[]
}

// ─────────────────────────────────────────
// APPOINTMENT
// ─────────────────────────────────────────
model Appointment {
  id              String            @id @default(cuid())
  shopId          String
  shop            Shop              @relation(fields: [shopId], references: [id])
  clientId        String
  client          Client            @relation(fields: [clientId], references: [id])
  barberId        String?
  barber          User?             @relation(fields: [barberId], references: [id])
  serviceId       String?
  service         Service?          @relation(fields: [serviceId], references: [id])
  date            DateTime
  durationMinutes Int               @default(30)
  status          AppointmentStatus @default(PENDING)
  notes           String?           @db.Text
  tip             Decimal?          @db.Decimal(10, 2)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  invoice  Invoice?
  reminder ServiceReminder?
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────
// INVOICE
// ─────────────────────────────────────────
model Invoice {
  id              String        @id @default(cuid())
  shopId          String
  shop            Shop          @relation(fields: [shopId], references: [id])
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  appointmentId   String?       @unique
  appointment     Appointment?  @relation(fields: [appointmentId], references: [id])
  invoiceNumber   String        // e.g. "INV-0042" — unique per shop
  status          InvoiceStatus @default(DRAFT)
  issuedAt        DateTime      @default(now())
  dueAt           DateTime?
  paidAt          DateTime?
  subtotal        Decimal       @db.Decimal(10, 2)
  taxRate         Decimal       @db.Decimal(5, 4) // 0.14975 = TPS+TVQ Quebec
  taxAmount       Decimal       @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  notes           String?       @db.Text
  pdfUrl          String?       // Supabase Storage URL
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lineItems InvoiceLineItem[]

  @@unique([shopId, invoiceNumber])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model InvoiceLineItem {
  id          String       @id @default(cuid())
  invoiceId   String
  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal      @db.Decimal(8, 2)
  unitPrice   Decimal      @db.Decimal(10, 2)
  lineTotal   Decimal      @db.Decimal(10, 2)
  itemType    LineItemType @default(CORTE)
  sortOrder   Int          @default(0)
}

enum LineItemType {
  CORTE
  PRODUCTO
  OTHER
}

// ─────────────────────────────────────────
// SERVICE REMINDER
// ─────────────────────────────────────────
model ServiceReminder {
  id             String         @id @default(cuid())
  shopId         String
  shop           Shop           @relation(fields: [shopId], references: [id])
  clientId       String
  client         Client         @relation(fields: [clientId], references: [id])
  appointmentId  String?        @unique
  appointment    Appointment?   @relation(fields: [appointmentId], references: [id])
  serviceType    String         // "Corte", "Barba", etc.
  dueDate        DateTime?
  notes          String?
  status         ReminderStatus @default(PENDING)
  sentAt         DateTime?
  createdAt      DateTime       @default(now())
}

enum ReminderStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  DISMISSED
}

// ─────────────────────────────────────────
// ACCOUNTING DOCUMENT
// ─────────────────────────────────────────
model AccountingDocument {
  id            String      @id @default(cuid())
  shopId        String
  shop          Shop        @relation(fields: [shopId], references: [id])
  category      DocCategory
  fileName      String
  storagePath   String      // Supabase Storage path (backup)
  driveFileId   String?     // Google Drive file ID
  driveFolderId String?
  uploadedAt    DateTime    @default(now())
  uploadedById  String?
  notes         String?
}

enum DocCategory {
  INVOICES
  RECEIPTS
  PAYROLL
  TAX_DOCUMENTS
  BANK_STATEMENTS
  OTHER
}
